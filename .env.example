# Optional: Netscape cookies — export to cookies.txt in project root (automatically mounted in Docker Compose).
# COOKIES_FILE=cookies.txt
#
# Optional: Proxy (e.g. residential proxy to bypass YouTube / Instagram IP blocks)
# PROXY_URL=http://user:password@proxy-server.com:8080
# PROXY_URL=socks5://user:password@proxy-server.com:1080

# Required: Telegram Bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Optional: Telegram API credentials for large file uploads (up to 2 GB)
# Get these free at https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=

# Optional: FastAPI backend URL (default: http://localhost:8000/api/v1, or in Docker Compose
# http://api:8000/api/v1 unless you override below). Set when the Telegram bot must reach the API
# over a public hostname instead of the internal service name.
# API_BASE_URL=http://localhost:8000/api/v1

# Optional: Public site URL (no trailing slash). Set when using the Caddy service / HTTPS so
# OpenAPI/Swagger "Try it out" matches your real host.
# PUBLIC_URL=https://anygrab.lwinminkhant.pro

# Optional: Comma-separated Host header values (production). Match your public hostname.
# localhost, 127.0.0.1, [::1], and api are always allowed (Docker healthchecks & internal Compose).
# TRUSTED_HOSTS=anygrab.lwinminkhant.pro

# Optional: CORS — for the web UI on your domain (same-origin fetches usually work without this; set if you call the API from another site).
# CORS_ORIGINS=https://anygrab.lwinminkhant.pro
# CORS_ORIGINS=*

# Optional: Performance tuning
# PORT=8000              # HTTP port; Render supplies PORT automatically
# MAX_EXTRACTIONS=6       # Max concurrent yt-dlp extractions (API server)
# MAX_DOWNLOADS=4         # Max concurrent downloads (API server)
# CACHE_TTL=300           # Extraction cache TTL in seconds (API server)
# RATE_LIMIT_REQ=30       # Rate limit: requests per window per IP (API server)
# RATE_LIMIT_WIN=60       # Rate limit: window in seconds (API server)
# WORKERS=1               # Uvicorn worker processes (API server)
# BOT_WORKERS=4           # Max concurrent bot downloads
# FRAGMENT_THREADS=8      # yt-dlp concurrent fragment downloads
# CAPTION_DEFAULT=true    # Show captions by default

# Google account sign-in and incremental Google Drive saving (optional).
# Create an OAuth Web application and enable the Google Drive API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep the same key across restarts/workers; changing it invalidates saved Google tokens.
ACCOUNT_ENCRYPTION_KEY=
ACCOUNT_DB_PATH=data/accounts.db
# Production redirect must use HTTPS; the frontend must share this origin.
# ACCOUNT_ORIGIN=https://your-domain.example

# Local transcription: install requirements-transcription.txt, then enable.
TRANSCRIPTION_ENABLED=false
WHISPER_MODEL=base
# AI study notes: create a Gemini API key; requests may incur provider charges.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional learning limits (per API worker). Jobs survive page navigation.
# LEARNING_WORKERS=2
# LEARNING_MAX_PENDING=8
# ACCOUNT_MAX_MEDIA_BYTES=209715200
# ACCOUNT_MAX_MEDIA_DURATION=7200
# TRANSCRIPTION_MAX_SECONDS=7200
# TRANSCRIPT_MAX_CHARS=300000
# STUDY_NOTES_MAX_CHARS=120000
# GEMINI_TIMEOUT_SECONDS=90
# Docker: set INSTALL_TRANSCRIPTION=1 and rebuild to include local speech recognition.
INSTALL_TRANSCRIPTION=0
